NODE_ENV=production
PORT=3333
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_BASE_URL=https://redesign-reg.kmutnb.ac.th
NEXT_PUBLIC_LANDING_PATH=/main
NEXT_PUBLIC_API_URL=https://reg4.kmutnb.ac.th/regapiweb2/api/th
JWT_SECRET=replace-with-strong-random-secret
ENCRYPT_SECRET_KEY=mySecretKeyHere
# Required for the current REG LoginAD cipher; do not randomize until legacy login is removed.
ADMIN_USER_ID=6701091611290
NEXT_PUBLIC_ADMIN_USER_ID=s6701091611290
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Current production database/storage wiring before the local PostgreSQL cutover.
NEXT_PUBLIC_SUPABASE_URL=https://tqbzejjswyexfyvtluup.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-current-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-current-supabase-anon-key

# Optional KMUTNB SSO backend migration settings.
# Keep KMUTNB SSO login disabled until the end-to-end bridge is ready.
KMUTNB_SSO_LOGIN_ENABLED=false

KMUTNB_SSO_BASE_URL=https://sso.kmutnb.ac.th
KMUTNB_SSO_CLIENT_ID=
KMUTNB_SSO_CLIENT_SECRET=
KMUTNB_SSO_REDIRECT_URI=https://redesign-reg.kmutnb.ac.th/api/auth/sso/callback
KMUTNB_SSO_SCOPES=openid profile email student_info
KMUTNB_SSO_ACCESS_TYPE=offline
KMUTNB_SSO_PROMPT=
KMUTNB_SSO_TOKEN_ENCRYPTION_KEY=replace-with-strong-random-secret
SUPABASE_SERVICE_ROLE_KEY=replace-with-current-supabase-service-role-key

# Google Classroom notification mirror.
GOOGLE_CLASSROOM_CLIENT_ID=
GOOGLE_CLASSROOM_CLIENT_SECRET=
GOOGLE_CLASSROOM_REDIRECT_URI=https://redesign-reg.kmutnb.ac.th/api/classroom/auth/callback
GOOGLE_CLASSROOM_SCOPES=openid email profile https://www.googleapis.com/auth/classroom.courses.readonly https://www.googleapis.com/auth/classroom.announcements.readonly https://www.googleapis.com/auth/classroom.coursework.me.readonly https://www.googleapis.com/auth/classroom.student-submissions.me.readonly
GOOGLE_CLASSROOM_ACCESS_TYPE=offline
GOOGLE_CLASSROOM_PROMPT=consent
GOOGLE_CLASSROOM_TOKEN_ENCRYPTION_KEY=replace-with-strong-random-secret
GOOGLE_CLASSROOM_SYNC_MIN_INTERVAL_SECONDS=60
GOOGLE_CLASSROOM_SYNC_LOOKBACK_DAYS=30
GOOGLE_CLASSROOM_NOTIFICATION_RETENTION_DAYS=90
GOOGLE_CLASSROOM_PUBSUB_TOPIC=projects/your-project-id/topics/google-classroom-notifications
GOOGLE_CLASSROOM_PUSH_TOKEN=replace-with-strong-random-secret
GOOGLE_CLASSROOM_ROLLOUT_MODE=pilot
GOOGLE_CLASSROOM_ROLLOUT_USERS=6701091611290
GOOGLE_CLASSROOM_GMAIL_QUERY=newer_than:30d ("Google Classroom" OR classroom OR assignment OR announcement)

# Public client-only Google Identity Services config for Gmail-backed Classroom POC.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLASSROOM_GMAIL_ROLLOUT_MODE=pilot
NEXT_PUBLIC_GOOGLE_CLASSROOM_GMAIL_ROLLOUT_USERS=6701091611290
NEXT_PUBLIC_GOOGLE_CLASSROOM_GMAIL_QUERY=newer_than:30d ("Google Classroom" OR classroom OR assignment OR announcement)

# ==================================== LINE OA ====================================
# LINE Messaging webhook ingress.
# If LINE must enter through research.kmutnb.ac.th, set LINE_WEBHOOK_PUBLIC_URL to the
# exact secret callback path provisioned on that host, e.g.
# https://research.kmutnb.ac.th/line-callbacks/redesign-reg/<secret>/webhook
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_WEBHOOK_PUBLIC_URL=
LINE_WEBHOOK_PROXY_SHARED_SECRET=
LINE_OA_BASIC_ID=
LINE_OA_ADD_FRIEND_URL=
# ================================= END LINE OA ==================================

# ================================= INSTAGRAM POC =================================
# Professional-account OAuth for the /settings/line Instagram POC.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
# Optional override. When empty, the app derives:
#   <request-origin>/api/instagram/link/callback
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_SCOPES=instagram_business_basic
# =============================== END INSTAGRAM POC ================================

# Local PostgreSQL and local storage targets for the cutover work.
DATABASE_URL=postgresql://redesign_reg:replace-with-db-password@127.0.0.1:5432/redesign_reg
LOCAL_STORAGE_ROOT=/var/www/reDesign-REG/web-app/storage
LOCAL_STORAGE_PUBLIC_BASE_URL=https://redesign-reg.kmutnb.ac.th/storage

# Agent-memory batch automation.
AGENT_MEMORY_GRAPHIFY_PYTHON=python3
AGENT_MEMORY_EMBEDDING_ENDPOINT=
AGENT_MEMORY_EMBEDDING_API_KEY=
AGENT_MEMORY_EMBEDDING_MODEL=Supabase/gte-small
AGENT_MEMORY_JOB_RETRY_ATTEMPTS=3
AGENT_MEMORY_JOB_RETRY_DELAY_MS=2000
