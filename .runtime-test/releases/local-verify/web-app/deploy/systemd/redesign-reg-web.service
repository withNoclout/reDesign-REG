[Unit]
Description=redesign-reg.kmutnb.ac.th Next.js application
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/reDesign-REG/.runtime/current/web-app
Environment=NODE_ENV=production
Environment=PORT=3333
Environment=HOSTNAME=127.0.0.1
Environment=NEXT_TELEMETRY_DISABLED=1
EnvironmentFile=/etc/redesign-reg/redesign-reg-web.env
EnvironmentFile=-/var/www/reDesign-REG/.runtime/current/web-app/.release-meta.env
ExecStartPre=/usr/bin/test -f /var/www/reDesign-REG/.runtime/current/web-app/.next/standalone/server.js
ExecStartPre=/usr/local/bin/node /var/www/reDesign-REG/.runtime/current/web-app/deploy/check-env.mjs
ExecStart=/usr/local/bin/node .next/standalone/server.js
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
StandardOutput=journal
StandardError=journal
SyslogIdentifier=redesign-reg-web
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
